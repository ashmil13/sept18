{
  "name": "romantic-birthday-surprise",
  "version": "1.0.0",
  "description": "Full-stack romantic birthday surprise website",
  "main": "index.js",
  "scripts": {
    "setup:photos": "node setup-photos.js",
    "install:all": "npm install && npm install --prefix server && npm install --prefix client",
    "setup": "npm run setup:photos && npm run install:all",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "concurrently": "^8.2.2"
  }
}